# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# Optional: Supabase publishable key (if different from anon key)
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Base URL for deployment (use '/' for local dev, '/BhumiShop/' for GitHub Pages)
VITE_BASE_URL=/

# Payment Gateway (MercadoPago)
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-your-mp-key

# Store URLs
VITE_UMAPENCA_STORE_URL=https://your-store-url
VITE_UICLAP_STORE_URL=https://your-uiclap-url

# Google OAuth (for admin login)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
